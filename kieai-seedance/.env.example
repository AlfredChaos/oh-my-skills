KIEAI_API_KEY=ka-your-kieai-api-key
KIEAI_BASE_URL=https://api.kie.ai
KIEAI_DEFAULT_MODEL=bytedance/seedance-2
KIEAI_OUTPUT_DIR=./outputs/kieai-seedance
KIEAI_REQUEST_TIMEOUT_SECONDS=60
KIEAI_WAIT_TIMEOUT_SECONDS=1800
KIEAI_POLL_INTERVAL_SECONDS=10
KIEAI_GENERATE_AUDIO=true
KIEAI_WEB_SEARCH=false
KIEAI_NSFW_CHECKER=true
